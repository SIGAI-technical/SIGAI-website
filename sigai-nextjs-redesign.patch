@@ -0,0 +1,69 @@
+import PopUp from './PopUp';
+import Placeholder from './Placeholder';
+import { ABOUT, ORG } from '@/lib/content';
+
+const FACTS = [
+  { term: 'Chapter', value: ORG.name },
+  { term: 'Department', value: ORG.department },
+  { term: 'Affiliation', value: ORG.parentBody },
+  { term: 'College', value: ORG.collegeFull },
+];
+
+/**
+ * About, folded into Home.
+ *
+ * It used to be a route of its own. The chapter has one story to tell and it
+ * belongs in the main flow, so it is set here exactly like every other section
+ * on the page — same label, same heading, same rule — and the nav points at the
+ * anchor instead of a separate page.
+ */
+export default function AboutSection() {
+  return (
+    <>
+      <div id="about" className="anchor-target" />
+      <div className="band band--about">
+        <div className="section">
+          <div className="shell">
+            <PopUp>
+              <span className="eyebrow">About us</span>
+              <h2 className="section-title">
+                Who we <span className="mark">are</span>
+              </h2>
+              <span className="rule rule--draw" aria-hidden />
+            </PopUp>
+
+            <PopUp delay={60}>
+              <p className="about__lead">{ABOUT.lead}</p>
+            </PopUp>
+
+            <div className="about__body">
+              <PopUp delay={80}>
+                <p className="about__rest">{ABOUT.rest}</p>
+              </PopUp>
+
+              <PopUp delay={140} angle="18deg">
+                <figure className="about__figure">
+                  <Placeholder label="The chapter — photo to be added" />
+                  <figcaption className="about__caption">
+                    {ORG.name}, DJSCE Mumbai
+                  </figcaption>
+                </figure>
+              </PopUp>
+            </div>
+
+            <PopUp delay={100}>
+              <dl className="facts">
+                {FACTS.map((f) => (
+                  <div key={f.term}>
+                    <dt>{f.term}</dt>
+                    <dd>{f.value}</dd>
+                  </div>
+                ))}
+              </dl>
+            </PopUp>
+          </div>
+        </div>
+      </div>
+    </>
+  );
+}
