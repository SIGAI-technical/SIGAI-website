@@ -0,0 +1,39 @@
+'use client';
+
+import { usePathname } from 'next/navigation';
+import { useEffect } from 'react';
+import {
+  initCountUp,
+  initMagnetic,
+  initPopUps,
+  initScrollFx,
+  initTilt,
+} from '@/lib/motion';
+import { initTheme } from '@/lib/chrome';
+
+/**
+ * Arms the page-wide behaviours.
+ *
+ * The theme switch and the scroll handler are wired once for the life of the
+ * layout; the reveal, tilt, magnet and count-up passes re-run on every route
+ * change, because Next swaps the page's DOM underneath a layout that stays
+ * mounted. The per-element passes all guard against double-arming — tilt marks
+ * its nodes, the observers unobserve on fire — so re-running them is cheap and
+ * never stacks duplicate listeners.
+ */
+export default function Effects() {
+  useEffect(() => {
+    initTheme();
+    initScrollFx();
+  }, []);
+
+  const pathname = usePathname();
+  useEffect(() => {
+    initPopUps();
+    initTilt();
+    initMagnetic();
+    initCountUp();
+  }, [pathname]);
+
+  return null;
+}
