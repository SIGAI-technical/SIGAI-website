@@ -0,0 +1,50 @@
+import Link from 'next/link';
+import Icon from './Icon';
+import { ICON } from '@/lib/content';
+
+/**
+ * The site's one button. The arrow travels on hover; the face itself is flat
+ * and near-square, which is what keeps it part of the same drawn system as the
+ * rules and hairlines rather than a capsule floating on top of them.
+ *
+ * `magnetic` wraps it in the span the pointer-attraction effect looks for.
+ */
+export default function Button({
+  href,
+  children,
+  variant = 'primary',
+  icon = ICON.arrow,
+  magnetic = true,
+  external,
+}: {
+  href: string;
+  children: React.ReactNode;
+  variant?: 'primary' | 'gold' | 'ghost';
+  icon?: string;
+  magnetic?: boolean;
+  external?: boolean;
+}) {
+  const inner = (
+    <>
+      {children}
+      <span className="btn__icon" aria-hidden>
+        <Icon path={icon} size={13} />
+      </span>
+    </>
+  );
+
+  const className = `btn btn--${variant}`;
+
+  // mailto:, tel: and in-page anchors are not routes, so they stay plain <a>.
+  const body = external || /^(mailto:|tel:|#)/.test(href) ? (
+    <a className={className} href={href}>
+      {inner}
+    </a>
+  ) : (
+    <Link className={className} href={href}>
+      {inner}
+    </Link>
+  );
+
+  return magnetic ? <span className="magnetic">{body}</span> : body;
+}
