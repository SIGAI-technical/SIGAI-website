-'use client';
-
-import { useEffect, useRef, useState } from 'react';
-
-/**
- * Counts a figure up from zero the first time it scrolls into view.
- *
- * The final value is what the server renders and what a screen reader or a
- * scriptless browser sees; the animation only ever replaces it after mount.
- * A stat that ships as "0" and depends on JavaScript to become true is a bug
- * waiting for the first person with a slow connection.
- */
-export default function CountUp({
-  value,
-  duration = 1100,
-}: {
-  value: number;
-  duration?: number;
-}) {
-  const ref = useRef<HTMLSpanElement>(null);
-  const [shown, setShown] = useState(value);
-  const started = useRef(false);
-
-  useEffect(() => {
-    const el = ref.current;
-    if (!el || started.current) return;
-
-    if (
-      typeof IntersectionObserver === 'undefined' ||
-      window.matchMedia('(prefers-reduced-motion: reduce)').matches
-    ) {
-      return;
-    }
-
-    const io = new IntersectionObserver(
-      ([entry]) => {
-        if (!entry.isIntersecting || started.current) return;
-        started.current = true;
-        io.disconnect();
-
-        const t0 = performance.now();
-        let raf = 0;
-        const tick = (now: number) => {
-          const p = Math.min(1, (now - t0) / duration);
-          // Ease-out cubic: fast off the mark, settling gently onto the number,
-          // which reads as a counter arriving rather than a value scrubbing.
-          const eased = 1 - Math.pow(1 - p, 3);
-          setShown(Math.round(eased * value));
-          if (p < 1) raf = requestAnimationFrame(tick);
-        };
-        setShown(0);
-        raf = requestAnimationFrame(tick);
-        return () => cancelAnimationFrame(raf);
-      },
-      { threshold: 0.5 },
-    );
-
-    io.observe(el);
-    return () => io.disconnect();
-  }, [value, duration]);
-
-  return (
-    <span ref={ref} style={{ fontVariantNumeric: 'tabular-nums' }}>
-      {shown}
-    </span>
-  );
-}
