+'use client';
+
+import { useEffect } from 'react';
+import { initFlips } from '@/lib/flips';
+import { AREAS } from '@/lib/content';
+
+/**
+ * The six focus areas, as cards that turn over.
+ *
+ * Built imperatively for the same reason the cube is: the turn state is
+ * latched per card and read back from the DOM by the handler that closes the
+ * others, and there is nothing React would add to six static faces.
+ */
+export default function FlipGrid() {
+  useEffect(() => {
+    initFlips([...AREAS]);
+  }, []);
+
+  return <ul className="flipgrid" id="flipgrid" />;
+}
