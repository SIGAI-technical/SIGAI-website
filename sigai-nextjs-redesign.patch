+'use client';
+
+import Image from 'next/image';
+import Link from 'next/link';
+import { usePathname } from 'next/navigation';
+import { useEffect, useRef } from 'react';
+import { initHeader } from '@/lib/chrome';
+import { LOGO_SRC } from '@/lib/site';
+
+const SUN =
+  'M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-13a1 1 0 0 1-1-1V1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1Zm0 20a1 1 0 0 1-1-1v-2a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1ZM4 13H2a1 1 0 1 1 0-2h2a1 1 0 1 1 0 2Zm18 0h-2a1 1 0 1 1 0-2h2a1 1 0 1 1 0 2ZM5.64 6.64 4.22 5.22a1 1 0 0 1 1.42-1.42L7.05 5.2A1 1 0 0 1 5.64 6.64Zm12.72 12.72-1.41-1.41a1 1 0 0 1 1.41-1.42l1.42 1.42a1 1 0 0 1-1.42 1.41ZM4.22 18.78a1 1 0 0 1 0-1.42l1.42-1.41A1 1 0 0 1 7.05 17.2l-1.41 1.41a1 1 0 0 1-1.42 0ZM16.95 7.05a1 1 0 0 1 0-1.41l1.41-1.42a1 1 0 1 1 1.42 1.42L18.36 7.05a1 1 0 0 1-1.41 0Z';
+const MOON =
+  'M21.4 14.3A9 9 0 1 1 9.7 2.6a1 1 0 0 1 1.28 1.28 7 7 0 0 0 9.14 9.14 1 1 0 0 1 1.28 1.28Z';
+
+/**
+ * Every link in the bar, in order. About is an anchor into Home rather than a
+ * route of its own — the chapter has one story to tell and it belongs in the
+ * main flow — so it never lights the indicator, which would otherwise show two
+ * active links whenever Home was open.
+ */
+const LINKS = [
+  { href: '/', label: 'Home' },
+  { href: '/#about', label: 'About', anchor: true },
+  { href: '/domains', label: 'AI' },
+  { href: '/events', label: 'Events' },
+  { href: '/team', label: 'Team' },
+  { href: '/contact', label: 'Contact' },
+];
+
+export default function SiteHeader() {
+  const pathname = usePathname();
+  const move = useRef<() => void>(() => {});
+
+  useEffect(() => {
+    move.current = initHeader();
+  }, []);
+
+  // The indicator is measured from the live DOM, so it has to be re-read after
+  // React has painted the new active link.
+  useEffect(() => {
+    move.current();
+  }, [pathname]);
+
+  const isActive = (href: string, anchor?: boolean) =>
+    !anchor && (href === '/' ? pathname === '/' : pathname.startsWith(href));
+
+  return (
+    <>
+      <a href="#main" className="skip">
+        Skip to content
+      </a>
+
+      <header className="site-header" id="header">
+        <span className="site-header__progress" id="progress" aria-hidden />
+
+        <div className="shell site-header__inner">
+          <Link href="/" className="brand" aria-label="SIGAI — home">
+            <span className="brand__plate" aria-hidden>
+              <Image src={LOGO_SRC} alt="" width={27} height={27} priority />
+            </span>
+            <span className="brand__name">
+              <b>SIGAI</b>
+              <span>DJS ACM</span>
+            </span>
+          </Link>
+
+          <nav className="nav-desktop" aria-label="Primary">
+            <div className="nav-rail" id="navRail">
+              <span className="nav-rail__indicator" id="navIndicator" aria-hidden />
+              {LINKS.map((l) => (
+                <Link
+                  key={l.href}
+                  className="nav-link"
+                  href={l.href}
+                  {...(isActive(l.href, l.anchor) ? { 'data-active': 'true' } : {})}
+                >
+                  {l.label}
+                </Link>
+              ))}
+            </div>
+          </nav>
+
+          {/* Sun and moon both live in the button; the switch rotates one out
+              and the other in, and a View Transition wipes the new theme
+              across the page from this point. */}
+          <button
+            className="theme-toggle"
+            id="themeToggle"
+            type="button"
+            aria-label="Switch theme"
+          >
+            <svg className="ico-sun" viewBox="0 0 24 24" fill="currentColor" aria-hidden>
+              <path d={SUN} />
+            </svg>
+            <svg className="ico-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden>
+              <path d={MOON} />
+            </svg>
+          </button>
+
+          <button
+            className="burger"
+            id="burger"
+            type="button"
+            aria-expanded="false"
+            aria-controls="sheet"
+            aria-label="Open menu"
+          >
+            <span />
+            <span />
+            <span />
+          </button>
+        </div>
+      </header>
+
+      {/* Full-bleed glass sheet for narrow screens; links stagger in. */}
+      <nav className="sheet" id="sheet" hidden aria-label="Primary">
+        {LINKS.map((l, i) => (
+          <Link
+            key={l.href}
+            href={l.href}
+            style={{ ['--i' as string]: `${60 + i * 50}ms` } as React.CSSProperties}
+          >
+            {l.label}
+          </Link>
+        ))}
+      </nav>
+    </>
+  );
+}
