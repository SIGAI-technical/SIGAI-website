+'use client';
+
+import { useEffect } from 'react';
+import { initShapes } from '@/lib/backdrop';
+
+/**
+ * Everything behind the page: the drifting aurora, the engineering grid, and
+ * the eight floating 3D cubes.
+ *
+ * All three are fixed and sit behind the content, and the ground they sit on
+ * is painted on <html> rather than on <body> — a z-index:-1 layer paints
+ * behind body's own background box, so an opaque body would hide the lot.
+ */
+export default function Backdrop() {
+  useEffect(() => {
+    initShapes();
+  }, []);
+
+  return (
+    <>
+      <div className="aurora" aria-hidden>
+        <span className="aurora__blob aurora__blob--a" />
+        <span className="aurora__blob aurora__blob--b" />
+        <span className="aurora__blob aurora__blob--c" />
+        <span className="aurora__blob aurora__blob--d" />
+      </div>
+      <div className="mesh" aria-hidden />
+      <div className="shapes" id="shapes" aria-hidden />
+    </>
+  );
+}
