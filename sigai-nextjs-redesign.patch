+/**
+ * The story panel: a tall track with a sticky panel inside it. The page keeps
+ * scrolling, the panel holds, and the slide cross-fades as you pass each
+ * quarter of the track.
+ */
+
+import { $, $$, calm, touch } from './dom';
+import type { Slide } from './content';
+
+export function initStory(slides: Slide[]): void {
+  const section = $('.story');
+  const stage = $('#storyStage');
+  const bars = $('#storyBars');
+  const reel = $('#storyReel');
+  const panel = $('#storyPanel');
+  if (!section || !stage) return;
+
+  let slideHtml = '', barHtml = '', reelHtml = '';
+  slides.forEach(function (s, i) {
+    slideHtml +=
+      '<article class="story__slide" data-on="' + (i === 0) + '">' +
+        '<span class="eyebrow">' + s.eyebrow + '</span>' +
+        '<h2 class="story__title">' + s.title + '</h2>' +
+        '<p class="story__body">' + s.body + '</p>' +
+      '</article>';
+    barHtml +=
+      '<button type="button" class="story__bar" data-on="' + (i === 0) + '" data-i="' + i + '"' +
+      ' aria-label="Go to: ' + s.title + '"></button>';
+    reelHtml +=
+      '<div class="story__cell"><div class="ph">' +
+        '<svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 8a5 5 0 1 1 0-10A5 5 0 0 1 12 17ZM1 7h3.5l2-2h11l2 2H23a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/></svg>' +
+        '<span>' + s.eyebrow + ' — image to be added</span>' +
+      '</div></div>';
+  });
+
+  stage.innerHTML = slideHtml;
+  bars.innerHTML = barHtml;
+  reel.innerHTML = reelHtml;
+
+  const slideEls = $$('.story__slide', stage);
+  const barEls = $$('.story__bar', bars);
+  let active = 0;
+  let frame = 0;
+
+  function setActive(i: number) {
+    if (i === active) return;
+    active = i;
+    slideEls.forEach(function (el, n) { el.setAttribute('data-on', String(n === i)); });
+    barEls.forEach(function (el, n) { el.setAttribute('data-on', String(n === i)); });
+    reel.style.transform = 'translate3d(0,-' + (i * 100) + '%,0)';
+  }
+
+  function onScroll() {
+    if (frame) return;
+    frame = requestAnimationFrame(function () {
+      frame = 0;
+      const rect = section.getBoundingClientRect();
+      /* How far through the tall track the sticky panel currently sits. */
+      const travelled = -rect.top;
+      const total = section.offsetHeight - window.innerHeight;
+      if (total <= 0) return;
+      const p = Math.min(0.999, Math.max(0, travelled / total));
+      setActive(Math.floor(p * slides.length));
+    });
+  }
+
+  window.addEventListener('scroll', onScroll, { passive: true });
+  window.addEventListener('resize', onScroll, { passive: true });
+  onScroll();
+
+  barEls.forEach(function (el) {
+    el.addEventListener('click', function () {
+      const i = parseInt(el.getAttribute('data-i') || '0', 10);
+      const total = section.offsetHeight - window.innerHeight;
+      /* Absolute page position, not offsetTop. The section sits inside a
+         `position: relative` band wrapper, which makes that wrapper its
+         offsetParent — so offsetTop is a few pixels rather than the
+         distance down the document, and every bar would scroll to the top
+         of the page instead of into the track. */
+      const top = section.getBoundingClientRect().top + window.scrollY;
+      window.scrollTo({
+        top: top + (total * (i + 0.5)) / slides.length,
+        behavior: calm() ? 'auto' : 'smooth'
+      });
+    });
+  });
+
+  /* The panel publishes the pointer position; the frame's CSS rotates
+     toward it. A shallower angle than the cards, because this element is
+     far larger on screen and a big surface needs less rotation to read. */
+  if (panel && !calm() && !touch()) {
+    panel.addEventListener('pointermove', function (e: PointerEvent) {
+      const r = panel.getBoundingClientRect();
+      if (!r.width || !r.height) return;
+      panel.style.setProperty('--tx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
+      panel.style.setProperty('--ty', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
+    });
+    panel.addEventListener('pointerleave', function () {
+      panel.style.setProperty('--tx', '0');
+      panel.style.setProperty('--ty', '0');
+    });
+  }
+}
