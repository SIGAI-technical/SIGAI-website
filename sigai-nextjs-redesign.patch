+'use client';
+
+import { useEffect } from 'react';
+import Button from './Button';
+import { initStory } from '@/lib/story';
+import { SLIDES } from '@/lib/content';
+
+/**
+ * A tall track with a sticky panel inside it: the page keeps scrolling, the
+ * panel holds, and the slide cross-fades as you pass each quarter.
+ *
+ * The slides are injected rather than rendered as JSX because the scroll
+ * handler owns which one is showing, and routing that through React state
+ * would mean a re-render on every frame of a scroll.
+ */
+export default function Story() {
+  useEffect(() => {
+    initStory(SLIDES);
+  }, []);
+
+  return (
+    <div className="band band--story">
+      <section
+        className="story"
+        style={{ ['--slides' as string]: SLIDES.length } as React.CSSProperties}
+        aria-label="What SIGAI is"
+      >
+        <div className="story__pin">
+          <div className="shell story__grid">
+            <div className="story__left">
+              <div
+                className="story__bars"
+                id="storyBars"
+                role="group"
+                aria-label="Jump to a chapter"
+              />
+              <div className="story__stage" id="storyStage" />
+              <div>
+                <Button href="/#about" variant="gold" magnetic={false}>
+                  Read our story
+                </Button>
+              </div>
+            </div>
+
+            {/* The panel publishes the pointer position as --tx/--ty and the
+                frame's CSS rotates toward it. */}
+            <div className="story__right" id="storyPanel" aria-hidden>
+              <div className="story__frame">
+                <div className="story__reel" id="storyReel" />
+              </div>
+            </div>
+          </div>
+        </div>
+      </section>
+    </div>
+  );
+}
