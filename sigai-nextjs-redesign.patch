-/* ====================================================================
-   17. LIVING BACKGROUND
-   ====================================================================
-
-   The first pass put the page on a flat warm white. Legible, but inert — the
-   whole surface sat at one brightness with nothing happening across it, which
-   is the "dull" the second round of feedback was about.
-
-   Three layers fix that without touching contrast, because none of them go
-   anywhere near the text:
-
-     1. `.aurora` — four large, heavily blurred colour blooms that drift on long
-        offset cycles. They never repeat their arrangement, so the ground is
-        subtly different every time you look at it.
-     2. `.shapes` — solid 3D cubelets parallaxing at different depths (below).
-     3. `.band` — each section on its own ground, so scrolling moves you through
-        rooms rather than down one sheet.
-   ==================================================================== */
-
-.aurora {
-  position: fixed;
-  inset: -12%;
-  z-index: -1;
-  pointer-events: none;
-  overflow: hidden;
-  /* Multiply keeps the blooms reading as pigment in the paper. Screen or
-     normal blending on a light ground washes them out to nothing. */
-  mix-blend-mode: multiply;
-}
-
-/*
- * Softness comes from the radial gradient's own falloff, not from a filter.
- *
- * The first version stacked `filter: blur(90px)` on four elements each around
- * half a viewport wide. That is an enormous amount of per-frame raster work on
- * layers that are already animating, and it showed: the compositor could not
- * keep up and the page intermittently painted as a flat empty layer. A radial
- * gradient fading to transparent gives the same soft field for free, because
- * the softness is in the paint rather than in a post-process over it.
- */
-.aurora__blob {
-  position: absolute;
-  border-radius: 50%;
-  will-change: transform;
-}
-
-.aurora__blob--a {
-  top: -8%;
-  left: -6%;
-  width: 52vw;
-  height: 46vw;
-  background: radial-gradient(circle, rgba(47, 107, 255, 0.42), transparent 66%);
-  animation: drift-a 34s ease-in-out infinite;
-}
-
-.aurora__blob--b {
-  top: 6%;
-  right: -10%;
-  width: 46vw;
-  height: 44vw;
-  background: radial-gradient(circle, rgba(245, 166, 35, 0.5), transparent 66%);
-  animation: drift-b 41s ease-in-out infinite;
-}
-
-.aurora__blob--c {
-  top: 46%;
-  left: 12%;
-  width: 58vw;
-  height: 40vw;
-  background: radial-gradient(circle, rgba(13, 148, 136, 0.34), transparent 68%);
-  animation: drift-c 47s ease-in-out infinite;
-}
-
-.aurora__blob--d {
-  bottom: -12%;
-  right: 4%;
-  width: 50vw;
-  height: 42vw;
-  background: radial-gradient(circle, rgba(120, 87, 255, 0.3), transparent 68%);
-  animation: drift-d 38s ease-in-out infinite;
-}
-
-/* Deliberately different periods and paths: matched cycles would sync up and
-   the field would visibly pulse. */
-@keyframes drift-a {
-  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
-  33% { transform: translate3d(8vw, 6vh, 0) scale(1.14); }
-  66% { transform: translate3d(-4vw, 10vh, 0) scale(0.94); }
-}
-
-@keyframes drift-b {
-  0%, 100% { transform: translate3d(0, 0, 0) scale(1.06); }
-  40% { transform: translate3d(-10vw, 8vh, 0) scale(0.9); }
-  70% { transform: translate3d(-3vw, -6vh, 0) scale(1.18); }
-}
-
-@keyframes drift-c {
-  0%, 100% { transform: translate3d(0, 0, 0) scale(0.96); }
-  50% { transform: translate3d(10vw, -8vh, 0) scale(1.2); }
-}
-
-@keyframes drift-d {
-  0%, 100% { transform: translate3d(0, 0, 0) scale(1.1); }
-  45% { transform: translate3d(-8vw, -6vh, 0) scale(0.92); }
-  75% { transform: translate3d(4vw, -2vh, 0) scale(1.05); }
-}
-
-/* The base mesh steps back now that the aurora carries the colour: it holds
-   the grid texture and a warm floor, nothing more. */
-/*
- * Transparent, so the aurora underneath it reads through. The mesh is now only
- * the engineering grid — a paper texture over the colour field rather than a
- * ground of its own.
- */
-body:has(.home-theme) .mesh {
-  background-color: transparent;
-  background-image:
-    linear-gradient(rgba(22, 33, 62, 0.03) 1px, transparent 1px),
-    linear-gradient(90deg, rgba(22, 33, 62, 0.03) 1px, transparent 1px);
-  background-size: 46px 46px, 46px 46px;
-}
-
-/* ====================================================================
-   18. FLOATING 3D SHAPES
-   ==================================================================== */
-
-.shapes {
-  position: fixed;
-  inset: 0;
-  z-index: -1;
-  pointer-events: none;
-  perspective: 900px;
-}
-
-/*
- * Below this width the content column reaches the viewport edges and there is
- * no margin for the shapes to live in — they would land on top of the text.
- * The field is decoration; when there is nowhere to put it, it goes away.
- */
-@media (max-width: 1180px) {
-  .shapes {
-    display: none;
-  }
-}
-
-.shape {
-  position: absolute;
-  width: var(--s);
-  height: var(--s);
-  transform-style: preserve-3d;
-  /*
-   * Three motions compose here, and the order is load-bearing:
-   *   translate3d — parallax against scroll and pointer, scaled by the shape's
-   *                 own depth, so near shapes travel further than far ones;
-   *   scale       — near shapes read slightly larger;
-   *   the child   — carries the continuous tumble, so the parallax transform
-   *                 can be rewritten every frame without restarting it.
-   */
-  transform:
-    translate3d(
-      calc(var(--px, 0) * var(--d) * 34px),
-      calc((var(--py, 0) * var(--d) * 26px) - (var(--sy, 0) * var(--d) * 0.09px)),
-      0
-    )
-    scale(calc(0.7 + (var(--d) * 0.45)));
-  opacity: calc(0.26 + (var(--d) * 0.3));
-  will-change: transform;
-}
-
-.shape__box {
-  position: relative;
-  width: 100%;
-  height: 100%;
-  transform-style: preserve-3d;
-  animation: shape-tumble var(--spin) linear infinite;
-  animation-delay: var(--offset);
-}
-
-@keyframes shape-tumble {
-  from { transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(0deg); }
-  to { transform: rotateX(calc(var(--rx) + 360deg)) rotateY(calc(var(--ry) + 360deg)) rotateZ(360deg); }
-}
-
-.shape__face {
-  position: absolute;
-  inset: 0;
-  border-radius: 22%;
-  border: 1px solid rgba(255, 255, 255, 0.5);
-  background: var(--face);
-}
-
-/* Six faces, assembled at half the edge length out along each axis. These are
-   genuine boxes: a faked cube would fall apart the moment it rotated, and
-   these rotate continuously. */
-.shape__face--fz { transform: translateZ(calc(var(--s) / 2)); }
-.shape__face--fzb { transform: rotateY(180deg) translateZ(calc(var(--s) / 2)); }
