+import Icon from './Icon';
+import { ICON } from '@/lib/content';
+
+/**
+ * An empty image slot.
+ *
+ * The photographs are coming later. Until they do, the slot has to look like a
+ * decision rather than like an image that failed to load — hence the label and
+ * the drawn frame. Dropping a picture in later replaces this one element and
+ * nothing else around it.
+ */
+export default function Placeholder({
+  label,
+  variant = 'plain',
+}: {
+  label: string;
+  variant?: 'plain' | 'media' | 'avatar';
+}) {
+  const cls =
+    'ph' +
+    (variant === 'media' ? ' ph--media' : '') +
+    (variant === 'avatar' ? ' ph--media ph--avatar' : '');
+
+  return (
+    <div className={cls}>
+      <Icon path={variant === 'avatar' ? ICON.person : ICON.camera} size={30} />
+      <span>{label}</span>
+    </div>
+  );
+}
