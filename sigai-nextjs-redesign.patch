+/**
+ * The focus-area cards. Hover, keyboard focus and a latched click all reach the
+ * same turned state, so the card works with a mouse, a keyboard or a thumb.
+ */
+
+import { $, $$ } from './dom';
+import { observePopUpsIn } from './motion';
+import type { Area } from './content';
+
+export function initFlips(areas: Area[]): void {
+  const grid = $('#flipgrid');
+  if (!grid) return;
+
+  let html = '';
+  areas.forEach(function (a, i) {
+    /* "AI" and "TRANSFORMER" cannot share a type size. */
+    const len = a.notation.length > 8 ? 'long' : (a.notation.length > 4 ? 'medium' : 'short');
+    html +=
+      '<li class="popup" style="--popup-delay:' + (i * 70) + 'ms;--popup-angle:20deg">' +
+        '<button type="button" class="flip" data-tone="' + a.tone + '" data-on="false"' +
+              ' aria-pressed="false" aria-label="' + a.term + '. ' + a.blurb + '">' +
+          '<span class="flip__inner">' +
+            '<span class="flip__face flip__front">' +
+              '<span class="flip__notation" data-len="' + len + '">' + a.notation + '</span>' +
+              '<span class="flip__term">' + a.term + '</span>' +
+              '<span class="flip__hint">Turn over' +
+                '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z"/></svg>' +
+              '</span>' +
+            '</span>' +
+            '<span class="flip__face flip__back" inert>' +
+              '<span class="flip__blurb">' + a.blurb + '</span>' +
+              '<span class="flip__term flip__term--back">' + a.term + '</span>' +
+            '</span>' +
+          '</span>' +
+        '</button>' +
+      '</li>';
+  });
+  grid.innerHTML = html;
+
+  $$('.flip', grid).forEach(function (btn) {
+    const back = $('.flip__back', btn);
+    btn.addEventListener('click', function () {
+      const on = btn.getAttribute('data-on') === 'true';
+      /* One card latched at a time — six open backs is noise. */
+      $$('.flip', grid).forEach(function (other) {
+        other.setAttribute('data-on', 'false');
+        other.setAttribute('aria-pressed', 'false');
+        $('.flip__back', other).setAttribute('inert', '');
+      });
+      if (!on) {
+        btn.setAttribute('data-on', 'true');
+        btn.setAttribute('aria-pressed', 'true');
+        back.removeAttribute('inert');
+      }
+    });
+  });
+
+  observePopUpsIn(grid);
+}
