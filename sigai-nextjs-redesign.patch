-@import "tailwindcss";
+/* ==========================================================================
+   DJS ACM SIGAI
+   ==========================================================================
+
+   The whole site's stylesheet. It is the design that was built and signed off
+   as a single deployable HTML file, ported here unchanged apart from the two
+   things that differ under Next: the font stacks read next/font's variables,
+   and the router's page show/hide is gone because each route is now its own
+   document.
+
+   Everything is driven from the token block at the top. Both themes are
+   defined there and nowhere else — no component rule lives inside a theme
+   block — which is what keeps light and dark from drifting apart.
+
+   Sections
+     1  Tokens
+     2  Reset and base
+     3  Background layers        (aurora, grid, floating 3D cubes)
+     4  Section bands
+     5  Header and mobile sheet
+     6  Intro curtain
+     7  Typography
+     8  Buttons
+     9  Motion primitives        (pop-up reveal, 3D tilt, magnetic)
+    10  Hero
+    11  Quick nav cards
+    12  Story panel
+    13  Image placeholders
+    14  Focus-area flip cards
+    15  Get involved
+    16  Contact
+    17  Footer
+    18  Responsive
+    19  Reduced motion
+   ========================================================================== */
+
+/* ==========================================================================
+   1. TOKENS
+   ========================================================================== */
 
 :root {
-  /* Brand — sampled from the SIGAI logo artwork. */
-  --ink: #05060b;
-  --ink-2: #080b16;
-  --cube-ink: #0b0b0f;
-  --cream: #ede6d6;
-  --blue: #2b5fff;
-  --blue-soft: #6f93ff;
-  --blue-deep: #12224f;
-  --gold: #f5c518;
-  --gold-soft: #ffdc6b;
-  --muted: #8b94ad;
-  --dim: #5f6880;
-  --line: #141a2e;
-  --line-soft: #17224a;
-  --panel: #101728;
-  --panel-deep: #080b16;
-
+  /* --- Ground ------------------------------------------------------------
+     Warm off-white rather than pure #fff. White at full brightness is what
+     makes long reading feel harsh; a couple of points of warmth fixes it
+     without the page ever looking grey. */
+  --h-bg: #fbfaf7;
+  --h-bg-sunk: #f5f2ec;
+  --h-surface: #ffffff;
+
+  /* --- Text --------------------------------------------------------------
+     Deep navy, not black. Pure black on off-white vibrates; navy sits
+     comfortably and ties back to the logo artwork. 15:1 on the ground. */
+  --h-ink: #16213e;
+  --h-ink-soft: #2c3a5c;
+  --h-muted: #59647f;
+  --h-dim: #7d879c;
+
+  --h-line: #eae6dd;
+  --h-line-strong: #ddd7ca;
+  /* Bounds a control rather than divides a surface, so it is a step darker
+     than the hairline. */
+  --h-edge: #c6bdaa;
+
+  /* --- Brand -------------------------------------------------------------
+     The chapter's blue and amber, darkened just enough to carry text at
+     4.5:1 on a light ground rather than only decorate it. */
+  --h-blue: #2f6bff;
+  --h-blue-deep: #1c46c9;
+  --h-blue-ink: #1233a0;
+  --h-blue-tint: #eaf1ff;
+  --h-blue-edge: #cfdeff;
+
+  --h-amber: #f5a623;
+  --h-amber-deep: #9a5c00;
+  --h-amber-tint: #fff4de;
+  --h-amber-edge: #f7e0b4;
+
+  /* A third accent, so a row of three cards is not the same two colours
+     twice. Also darkened to carry a label, not just an icon. */
+  --h-teal: #0b8177;
+  --h-teal-tint: #e3f6f3;
+  --h-teal-edge: #bfe8e2;
+
+  /* --- Elevation ---------------------------------------------------------
+     There are no drop shadows any more. A soft shadow under every block is
+     what made the page read as a stack of floating template cards; depth now
+     comes from hairlines, from the 3D tilt, and from the accent rules. The
+     tokens stay in place so nothing needs rewiring — they simply resolve to
+     nothing. */
+  --h-lift-1: none;
+  --h-lift-2: none;
+  --h-lift-3: none;
+
+  /* Near-square. A 20px radius plus a soft shadow on every block was the
+     loudest generic-template signal on the page; 3px reads as a drawn edge
+     rather than as a floating pill, and it is the same edge the hairline
+     grids and the rules use. */
+  --h-radius: 3px;
   --shell: clamp(20px, 4vw, 44px);
-  --display: var(--font-press-start), ui-monospace, monospace;
 
-  /* Motion — weighted curves, never linear/ease-in-out. */
-  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
-  --ease-spring: cubic-bezier(0.32, 0.72, 0, 1);
-}
+  /* next/font self-hosts both faces and exposes them as the two variables
+     below. The fallback goes *inside* var(), not after it: an undefined custom
+     property makes the whole font-family declaration invalid at computed-value
+     time, so if next/font ever fails to define one the page would drop all the
+     way to the browser's default serif rather than to the system sans. With
+     the fallback inside, it degrades one step at a time. */
+  --h-display: var(--font-outfit, Outfit), system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --h-body: var(--font-inter, Inter), system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+
+  /* Weighted curves. Never linear, never ease-in-out. */
+  --ease-out-expo: cubic-bezier(.16, 1, .3, 1);
+  --ease-spring: cubic-bezier(.32, .72, 0, 1);
+
+  /* --- Surfaces that have to flip with the theme -------------------------
+     Everything below was a hard-coded literal in the first build. That is
+     what broke dark mode: the header kept its cream background while the page
+     went black, so the nav links had to be forced to a colour that suited the
+     wrong surface. A surface that changes with the theme has to be a token. */
+
+  --h-header: rgba(251, 250, 247, .82);
+  --h-header-solid: rgba(251, 250, 247, .94);
+  --h-header-shadow: 0 10px 30px -22px rgba(22, 33, 62, .5);
+  --h-glass: rgba(251, 250, 247, .96);
+  --h-plate: linear-gradient(150deg, #fff, #f2f5ff);
+  --h-hint: rgba(255, 255, 255, .86);
+
+  /* The fine engineering grid, and the heavier one behind the story panel. */
+  --h-grid: rgba(22, 33, 62, .03);
+  --h-grid-strong: rgba(22, 33, 62, .045);
+
+  /* Inner top highlight on raised tiles — light catching an edge. */
+  --h-sheen: rgba(255, 255, 255, .8);
+  --h-shape-edge: rgba(255, 255, 255, .5);
+  --h-ph-stripe: rgba(22, 33, 62, .028);
+  --h-avatar-plate: rgba(255, 255, 255, .55);
+
+  /* Aurora. `multiply` sinks colour into a light ground; over black it would
+     multiply to black, so the blend mode is a token too. */
+  --h-aurora-blend: multiply;
+  --h-aurora-a: rgba(47, 107, 255, .42);
+  --h-aurora-b: rgba(245, 166, 35, .5);
+  --h-aurora-c: rgba(13, 148, 136, .34);
+  --h-aurora-d: rgba(120, 87, 255, .3);
+
+  /* One ground, not seven.
+     Each section used to carry its own tinted gradient — blue here, teal
+     there, amber below. On a light page that was a gentle change of room; on
+     a black one it came out as visible patches of different colour, which is
+     what made dark mode look uneven. There is now a single ground and one
+     half-step warmer alternate, and all the colour in the page comes from the
+     drifting aurora behind it. */
+  --h-band: transparent;
+  --h-band-alt: rgba(243, 240, 232, .5);
+
+  /* The marker stroke behind an emphasised phrase. On paper it is a highlighter;
+     on black a solid amber bar goes muddy brown, so the dark theme drops it to
+     a glow and lifts the text to the brighter blue. */
+  --h-mark-text: var(--h-blue-deep);
+  --h-mark-bg: linear-gradient(180deg,
+    transparent 0 54%,
+    rgba(245, 166, 35, .34) 54% 84%,
+    transparent 84%);
+
+  color-scheme: light;
+}
+
+/* ==========================================================================
+   1b. DARK THEME
+   ==========================================================================
+
+   The palette below is the one you picked — pure black grounds, brightened
+   blue, amber and teal. Only tokens are redefined here; not a single component
+   rule lives inside this block, which is what keeps the two themes from
+   drifting apart.
+
+   Three states, not two: an explicit choice stamps data-theme on <html>, and
+   the default "system" setting stamps nothing — so the media query has to
+   cover the un-stamped case, guarded so an explicit light choice still beats
+   a dark OS. */
+
+:root[data-theme="dark"] {
+  --h-bg: #000000;
+  --h-bg-sunk: #000000;
+  --h-surface: #0b0b0b;
+
+  --h-ink: #ffffff;
