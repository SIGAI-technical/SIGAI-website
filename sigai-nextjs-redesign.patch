@@ -0,0 +1,76 @@
+'use client';
+
+import { useRef } from 'react';
+
+export interface TabItem {
+  value: string;
+  label: string;
+  count?: number;
+}
+
+/**
+ * One tablist, following the WAI-ARIA tabs pattern: arrow keys move between
+ * tabs, Home and End jump to the ends, and only the selected tab is in the tab
+ * order — so a keyboard user tabs past the whole row in one press rather than
+ * through every year.
+ */
+export default function Tabs({
+  items,
+  value,
+  onChange,
+  label,
+  id,
+}: {
+  items: TabItem[];
+  value: string;
+  onChange: (value: string) => void;
+  label: string;
+  id?: string;
+}) {
+  const host = useRef<HTMLDivElement>(null);
+
+  const onKeyDown = (e: React.KeyboardEvent) => {
+    const i = items.findIndex((it) => it.value === value);
+    let next: number | null = null;
+    if (e.key === 'ArrowRight') next = (i + 1) % items.length;
+    else if (e.key === 'ArrowLeft') next = (i - 1 + items.length) % items.length;
+    else if (e.key === 'Home') next = 0;
+    else if (e.key === 'End') next = items.length - 1;
+    if (next === null) return;
+    e.preventDefault();
+    onChange(items[next].value);
+    // Focus has to follow the selection, or the next arrow key comes from the
+    // old tab and the row walks backwards.
+    const btns = host.current?.querySelectorAll<HTMLButtonElement>('.tab');
+    btns?.[next]?.focus();
+  };
+
+  return (
+    <div
+      ref={host}
+      role="tablist"
+      aria-label={label}
+      className="tabs"
+      id={id}
+      onKeyDown={onKeyDown}
+    >
+      {items.map((it) => {
+        const on = it.value === value;
+        return (
+          <button
+            key={it.value}
+            type="button"
+            role="tab"
+            className="tab"
+            aria-selected={on}
+            tabIndex={on ? 0 : -1}
+            onClick={() => onChange(it.value)}
+          >
+            {it.label}
+            {it.count != null && <span className="tab__count">{it.count}</span>}
+          </button>
+        );
+      })}
+    </div>
+  );
+}
