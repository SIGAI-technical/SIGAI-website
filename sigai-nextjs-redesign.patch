- */
-html:has(.home-theme) {
-  --ink: var(--h-bg);
-  --ink-2: var(--h-bg-sunk);
-  --cube-ink: var(--h-ink);
-  --cream: var(--h-ink);
-  --blue: var(--h-blue);
-  --blue-soft: var(--h-blue-deep);
-  --blue-deep: var(--h-blue-tint);
-  --gold: var(--h-amber-deep);
-  --gold-soft: var(--h-amber);
-  --muted: var(--h-muted);
-  --dim: var(--h-dim);
-  --line: var(--h-line);
-  --line-soft: var(--h-line-strong);
-  --panel: var(--h-surface);
-  --panel-deep: var(--h-surface-warm);
-  --display: var(--h-display);
-}
-
-/*
- * Note what is deliberately NOT here: a `perspective`.
- *
- * A perspective on an ancestor makes that element the containing block for any
- * `position: fixed` descendant. The aurora field and the floating shapes are
- * both fixed layers inside this wrapper, so a page-level perspective would
- * silently re-anchor them to the full 8,000px height of the page instead of to
- * the viewport — the blooms end up enormous and mostly off-screen, and the
- * shapes land in the middle of the content instead of the margins. Each 3D
- * effect declares its own perspective locally instead, which is better anyway:
- * one shared vanishing point at the centre of the page shears anything far
- * from it rather than rotating it.
- */
-.home-theme {
-  color: var(--h-ink);
-  font-family: var(--h-body);
-}
-
-/* Light form controls, light scrollbar, light autofill. */
-html:has(.home-theme) {
-  color-scheme: light;
-}
-
-body:has(.home-theme) ::selection {
-  background: var(--h-blue-tint);
-  color: var(--h-blue-ink);
-}
-
-body:has(.home-theme) :focus-visible {
-  outline: 2px solid var(--h-blue);
-  outline-offset: 3px;
-}
-
-/* ====================================================================
-   2. BACKDROP
-   ==================================================================== */
-
-/*
- * The dark theme paints a near-black mesh with neon orbs and film grain. On the
- * homepage the colour moved to the aurora layer (section 17) and this element
- * keeps only the grid texture — see the .mesh rule there, which supersedes the
- * dark theme's declarations wholesale.
- */
-
-/* Grain over a light ground reads as dirt, not film. */
-body:has(.home-theme) .grain {
-  opacity: 0.02;
-  mix-blend-mode: multiply;
-}
-
-/* CRT scanlines are a dark-theme device; on light they just muddy the page. */
-.home-theme .section::before {
-  display: none;
-}
-
-/* ====================================================================
-   3. HEADER
-   ==================================================================== */
-
-body:has(.home-theme) .site-header {
-  background: rgba(251, 250, 247, 0.82);
-  border-bottom-color: var(--h-line);
-}
-
-body:has(.home-theme) .site-header[data-scrolled='true'] {
-  background: rgba(251, 250, 247, 0.94);
-  border-bottom-color: var(--h-line-strong);
-  box-shadow: 0 10px 30px -22px rgba(22, 33, 62, 0.5);
-}
-
-body:has(.home-theme) .site-header::before {
-  background: linear-gradient(
-    90deg,
-    transparent,
-    var(--h-blue) 18%,
-    var(--h-amber) 52%,
-    var(--h-blue) 84%,
-    transparent
-  );
-  opacity: 0.3;
-}
-
-body:has(.home-theme) .site-header__progress {
-  background: linear-gradient(90deg, var(--h-blue), var(--h-amber));
-}
-
-body:has(.home-theme) .brand__plate {
-  border-color: var(--h-line);
-  background: linear-gradient(150deg, #ffffff, #f2f5ff);
-  box-shadow: var(--h-lift-1);
-}
-
-/* The mark artwork is cream-on-dark; invert it so it reads on the light plate. */
-body:has(.home-theme) .brand__plate img {
-  filter: invert(1) brightness(0.32) saturate(1.4) hue-rotate(200deg);
-}
-
-body:has(.home-theme) .brand span,
-body:has(.home-theme) .site-header__inner {
-  color: var(--h-ink);
-}
-
-body:has(.home-theme) .nav-link {
-  color: var(--h-muted);
-  font-family: var(--font-inter), system-ui, sans-serif;
-  font-weight: 500;
-}
-
-body:has(.home-theme) .nav-link:hover {
-  color: var(--h-ink);
-  background: rgba(47, 107, 255, 0.07);
-}
-
-body:has(.home-theme) .nav-link[data-active='true'] {
-  color: var(--h-blue-ink);
-}
-
-body:has(.home-theme) .nav-rail__indicator {
-  background: linear-gradient(90deg, var(--h-blue), var(--h-amber));
-  /* The pulsing neon glow is the single most "cyberpunk" thing in the nav. */
-  animation: none;
-}
-
-body:has(.home-theme) .burger {
-  border-color: var(--h-line-strong);
-  background: var(--h-surface);
-}
-
-body:has(.home-theme) .burger span {
-  background: var(--h-ink);
-}
-
-body:has(.home-theme) .sheet {
-  background: rgba(251, 250, 247, 0.96);
-}
-
-body:has(.home-theme) .sheet a {
-  font-family: var(--h-display);
-  font-weight: 600;
-  letter-spacing: -0.01em;
-  color: var(--h-ink);
-  border-bottom-color: var(--h-line);
-}
-
-body:has(.home-theme) .sheet a[aria-current='page'] {
-  color: var(--h-blue-ink);
-}
-
-body:has(.home-theme) .skip {
-  background: var(--h-blue);
-  color: #fff;
-}
-
-/* ====================================================================
-   4. INTRO CURTAIN
-   ==================================================================== */
-
-/*
- * The curtain plays on a full page load before the homepage is visible. Left
- * dark it would flash near-black and then snap to a light page, which is the
- * exact eye-strain the brief is about — so on the homepage it lifts on the
- * same warm ground the page itself uses.
- */
-body:has(.home-theme) .intro {
-  background: var(--h-bg);
-}
-
-body:has(.home-theme) .intro::before {
-  background-image:
-    radial-gradient(ellipse 62% 52% at 22% 16%, rgba(47, 107, 255, 0.14), transparent 70%),
-    radial-gradient(ellipse 56% 56% at 80% 80%, rgba(245, 166, 35, 0.16), transparent 70%);
-}
-
-body:has(.home-theme) .intro__tile {
-  background-image: url('/logo-mark-navy.png');
-}
-
-body:has(.home-theme) .intro__name {
-  font-family: var(--font-outfit), system-ui, sans-serif;
-  font-weight: 700;
-  letter-spacing: 1.5px;
-  color: var(--h-ink);
-}
-
-body:has(.home-theme) .intro__sub {
-  color: var(--h-muted);
-}
-
-body:has(.home-theme) .intro__rule,
-body:has(.home-theme) .intro__meter {
-  background: linear-gradient(90deg, var(--h-blue), var(--h-amber));
-}
-
-/* ====================================================================
-   5. FOOTER
-   ==================================================================== */
-
-/*
- * The footer paints its own ground and its blue→amber top hairline as two
- * stacked inline background layers, so there is no element or variable to
- * recolour from the outside — the whole stack has to be restated. The
- * shorthand goes first (it would otherwise wipe the longhands that follow),
- * then each longhand re-establishes the two-layer geometry.
- */
-body:has(.home-theme) footer {
-  background: var(--h-bg-sunk) !important;
-  background-image:
-    linear-gradient(
-      90deg,
-      transparent 0%,
-      var(--h-blue) 20%,
-      var(--h-amber) 50%,
-      var(--h-blue) 80%,
-      transparent 100%
-    ),
-    linear-gradient(var(--h-bg-sunk), var(--h-bg-sunk)) !important;
-  background-size: 100% 2px, 100% 100% !important;
-  background-repeat: no-repeat !important;
-  background-position: top, 0 0 !important;
-  color: var(--h-ink);
-}
-
-body:has(.home-theme) footer .footer__mark > span {
-  font-family: var(--h-display);
-  font-weight: 800;
-  letter-spacing: -0.03em;
-  color: var(--h-ink);
-}
-
-body:has(.home-theme) footer .footer__mark > p {
-  color: var(--h-muted);
-}
-
-body:has(.home-theme) footer a {
-  color: var(--h-muted);
-}
-
-body:has(.home-theme) footer a:hover {
-  color: var(--h-blue-ink);
-}
-
-body:has(.home-theme) footer .icon-link {
-  border-color: var(--h-line-strong);
-  background: var(--h-surface);
-  color: var(--h-muted);
-}
-
-body:has(.home-theme) footer .icon-link:hover {
-  color: var(--h-blue-ink);
-  border-color: var(--h-blue-edge);
-  background: var(--h-blue-tint);
-  box-shadow: var(--h-lift-1);
-}
-
-/* ====================================================================
-   6. TYPOGRAPHY
-   ==================================================================== */
-
-/*
- * The single biggest legibility change on the page. Press Start 2P is a 6x6
- * bitmap face: every glyph is the same width, there is no lowercase to speak
- * of, and at heading sizes the aliased edges force the eye to re-focus on each
- * word. Outfit keeps the geometric, slightly technical feel of the original
- * without any of that cost. (`--display` itself is re-pointed in the token
- * remap above, which is what catches the headings set inline.)
- */
-.home-theme h1,
-.home-theme h2,
-.home-theme h3,
-.home-theme .section-title,
-.home-theme .story__title,
-.home-theme .quicknav__title {
-  font-family: var(--h-display);
-  letter-spacing: -0.025em;
-  color: var(--h-ink);
-  text-wrap: balance;
-}
-
-.home-theme p,
-.home-theme li,
-.home-theme dd,
-.home-theme dt {
-  font-family: var(--h-body);
-}
-
-.home-theme .section-title {
-  font-size: clamp(26px, 3.4vw, 42px);
-  font-weight: 700;
-  line-height: 1.18;
-}
-
-.home-theme .section-lede,
-.home-theme .story__body,
-.home-theme .quicknav__body {
-  color: var(--h-muted);
-  /* 1.7 rather than 1.85: with a proper text face the extra leading starts to
-     pull lines apart instead of helping. */
-  line-height: 1.7;
-}
-
-.home-theme .section-lede {
-  font-size: clamp(16px, 1.25vw, 18px);
-}
-
-/*
- * The eyebrow loses the `[ LABEL ]_` terminal brackets and blinking cursor.
- * That treatment is the most machine-like element on the page — a blinking
- * cursor is literally a computer waiting for input. It becomes a small
- * capsule instead: still a label, but one a person would design.
- */
-.home-theme .eyebrow {
-  /* Several parents are stretch-aligned flex columns, which would pull an
-     inline-flex pill out to the full column width. */
-  align-self: flex-start;
-  width: fit-content;
-  padding: 6px 13px 6px 11px;
-  border-radius: 999px;
-  border: 1px solid var(--h-amber-edge);
-  background: var(--h-amber-tint);
-  color: var(--h-amber-deep);
-  font-family: var(--h-body);
-  font-size: 11.5px;
-  font-weight: 600;
-  letter-spacing: 0.07em;
-}
-
-.home-theme .eyebrow::before {
-  content: '';
-  width: 5px;
-  height: 5px;
-  border-radius: 999px;
-  background: var(--h-amber);
-  font-size: 0;
-  opacity: 1;
-  animation: none;
-}
-
-.home-theme .eyebrow::after {
-  content: none;
-}
-
-/*
- * The emphasised half of a heading.
- *
- * The dark theme runs a blue→gold gradient through the letterforms. That does
- * not survive the move to a light ground: any ramp between a saturated blue and
- * a saturated amber has to cross low-chroma territory, and whichever colour
- * space you interpolate in, the middle of the word pays for it — sRGB and OKLab
- * both sag through grey, and OKLCH takes the short arc around the hue wheel and
- * comes out pink. A word the reader is meant to read should not have its
- * weakest contrast in the middle.
- *
- * So both brand colours stay, but they stop competing for the same pixels: the
- * text is solid brand blue, and the amber becomes a highlighter stroke ruled
- * across the lower third behind it. It carries the same two-colour identity,
- * every letter holds full contrast, and a hand-drawn marker line is exactly the
- * warmth the page was missing.
- */
-.home-theme .mark {
-  padding-inline: 0.08em;
-  background:
-    linear-gradient(
-      180deg,
-      /* Struck across the lower third of the letterforms, the way a marker
-         actually lands — not tucked underneath them like an underline. */
-      transparent 0 54%,
-      rgba(245, 166, 35, 0.34) 54% 84%,
-      transparent 84%
-    );
-  -webkit-background-clip: border-box;
-  background-clip: border-box;
-  color: var(--h-blue-deep);
-}
-
-/*
- * The accent rule drops its chromatic-aberration ghost — a deliberate
- * mis-registration effect that only makes sense in a glitch idiom.
- */
-.home-theme .rule {
-  width: 52px;
-  height: 4px;
-  border-radius: 999px;
-  background: linear-gradient(90deg, var(--h-blue), var(--h-amber));
-}
-
-.home-theme .rule::after {
-  content: none;
-}
-
-/* ====================================================================
-   7. BUTTONS
-   ==================================================================== */
-
-/*
- * The dark theme's buttons are neobrutalist: 2px border, hard un-blurred
- * offset shadow in the opposite accent, snapping down on press. Read together
- * with the square cards it is what gives the page its rigid, stamped-out
- * feel. These are softer — pill radius, real elevation, a small lift — and
- * still have a physical press, just a gentler one.
- */
-.home-theme .btn {
-  padding: 13px 14px 13px 24px;
-  border-radius: 999px;
-  border: 1px solid transparent;
-  font-family: var(--h-body);
-  font-size: 14px;
-  font-weight: 600;
-  letter-spacing: 0.005em;
-  text-transform: none;
-  transform: translateZ(0);
-  transition:
-    background 260ms var(--ease-out-expo),
-    color 260ms var(--ease-out-expo),
-    box-shadow 260ms var(--ease-out-expo),
-    transform 260ms var(--ease-spring);
-}
-
-.home-theme .btn:active {
-  transform: translateY(1px) scale(0.985) !important;
-  box-shadow: var(--h-lift-1) !important;
-}
-
-.home-theme .btn__icon {
-  width: 28px;
-  height: 28px;
-  border-radius: 999px;
-  background: rgba(255, 255, 255, 0.2);
-}
-
-/*
- * The gradient starts one step down from the raw brand blue: at #2f6bff, white
- * label text lands on exactly 4.50:1, which is the AA threshold to the decimal
- * and leaves nothing for a rounding error or a slightly different screen.
- * #2a63f2 puts it at 5.0:1 and is indistinguishable side by side.
- */
-.home-theme .btn--primary {
-  background: linear-gradient(135deg, #2a63f2 0%, var(--h-blue-deep) 100%);
-  border-color: var(--h-blue-deep);
-  color: #fff;
-  box-shadow:
-    0 1px 2px rgba(28, 70, 201, 0.24),
-    0 10px 22px -10px rgba(47, 107, 255, 0.62);
-}
-
-.home-theme .btn--primary:hover {
-  transform: translateY(-2px);
-  box-shadow:
-    0 2px 4px rgba(28, 70, 201, 0.2),
-    0 18px 34px -12px rgba(47, 107, 255, 0.66);
-}
-
-.home-theme .btn--gold {
-  background: linear-gradient(135deg, #ffc046 0%, var(--h-amber) 100%);
-  border-color: rgba(183, 110, 0, 0.4);
-  /* Navy on amber, not black: 8.9:1, and it keeps the brand pairing. */
-  color: var(--h-ink);
-  box-shadow:
-    0 1px 2px rgba(183, 110, 0, 0.22),
-    0 10px 22px -10px rgba(245, 166, 35, 0.68);
-}
-
-.home-theme .btn--gold:hover {
-  transform: translateY(-2px);
-  box-shadow:
-    0 2px 4px rgba(183, 110, 0, 0.2),
-    0 18px 34px -12px rgba(245, 166, 35, 0.7);
-}
-
-.home-theme .btn--gold .btn__icon {
-  background: rgba(22, 33, 62, 0.12);
-}
-
-.home-theme .btn--ghost {
-  background: var(--h-surface);
-  border-color: var(--h-line-strong);
-  color: var(--h-ink);
-  box-shadow: var(--h-lift-1);
-}
-
-.home-theme .btn--ghost:hover {
-  border-color: var(--h-blue-edge);
-  background: var(--h-surface);
-  color: var(--h-blue-ink);
-  transform: translateY(-2px);
-  box-shadow: var(--h-lift-2);
-}
-
-.home-theme .btn--ghost .btn__icon {
-  background: rgba(22, 33, 62, 0.06);
-}
-
-/* ====================================================================
-   8. CARDS
-   ==================================================================== */
-
-/*
- * The "checkbox" problem.
- *
- * The old card is a 2px hard-edged blue rectangle with a solid amber square
- * offset behind it and a 4px corner radius. That is, almost exactly, the
- * drawing of a checked tickbox — and repeated three times in a grid it reads
- * as a form, not as content. It also has no depth cue that matches how light
- * actually behaves, which is what makes it feel machine-drawn.
- *
- * The replacement: a real surface. Generous 20px radius, a hairline that only
- * suggests an edge, and two stacked shadows so it looks like a card resting on
- * paper. The accent moves off the border and into a soft coloured wash in the
- * corner, different per card, so the row has variety instead of repetition.
- */
-.home-theme .bezel {
-  border: 1px solid var(--h-line);
-  border-radius: var(--h-radius);
-  background: var(--h-surface);
-  box-shadow: var(--h-lift-1);
-  transform-style: preserve-3d;
-  transition:
-    border-color 320ms var(--ease-out-expo),
-    box-shadow 320ms var(--ease-out-expo),
-    transform 320ms var(--ease-spring);
-}
-
-.home-theme .bezel:hover {
-  border-color: var(--h-line-strong);
-  box-shadow: var(--h-lift-2);
-  /* The lift comes from the tilt wrapper now; don't double-translate. */
-  transform: none;
-}
-
-.home-theme .bezel__core {
-  border-radius: calc(var(--h-radius) - 1px);
-  background: transparent;
-}
-
-/* The diagonal hatch and the sweeping sheen are both dark-theme flourishes. */
-.home-theme .sheen::after {
-  display: none;
-}
-
-/*
- * Cursor spotlight: on the dark card this was a hard amber ring tracking the
- * pointer around the border. Here it's a wide, low-opacity warm bloom inside
- * the card — the same idea, expressed as light falling on paper.
- */
-.home-theme .spotlight::before {
-  padding: 0;
-  border-radius: inherit;
-  background: radial-gradient(
-    420px circle at var(--mx, 50%) var(--my, 50%),
-    rgba(47, 107, 255, 0.07),
-    transparent 60%
-  );
-  -webkit-mask: none;
-  mask: none;
-  mask-composite: initial;
-  -webkit-mask-composite: initial;
-}
-
-/* ====================================================================
-   9. 3D TILT
-   ==================================================================== */
-
-/*
- * Pointer-driven tilt. The wrapper reports the cursor's position as a pair of
- * normalised CSS variables and the card rotates toward it, which gives a real
- * parallax response rather than a canned hover animation. `will-change` is set
- * only while the pointer is actually over the element so idle cards don't hold
- * a compositor layer each.
- */
-.tilt {
-  /* Local vanishing point, so a card at the edge of the grid rotates rather
-     than shearing toward a page-centre origin. */
-  perspective: 1000px;
-  transform-style: preserve-3d;
-  transition: transform 420ms var(--ease-spring);
-}
-
-.tilt[data-lit='true'] {
-  will-change: transform;
-  /* Short transition while tracking, so the card follows the cursor closely
-     but never jitters frame to frame. */
-  transition: transform 90ms linear;
-}
-
-.tilt__inner {
-  height: 100%;
-  transform-style: preserve-3d;
-  transform:
-    rotateX(calc(var(--ty, 0) * -1 * var(--tilt-deg, 5deg)))
-    rotateY(calc(var(--tx, 0) * var(--tilt-deg, 5deg)))
-    translateZ(0);
-  transition: transform 420ms var(--ease-spring);
-}
-
-/*
- * The lift on hover is a translateY, not a translateZ.
- *
- * Pushing a text-bearing surface along Z makes the browser rasterise it at one
- * scale and then resample it to another, and body copy visibly softens. A
- * rotation alone already costs a little sharpness; adding a large Z offset on
- * top of it is what tips the card from "in perspective" to "slightly out of
- * focus". Y gives the same read of the card rising toward the cursor and costs
- * nothing, and the shadow stepping up to --h-lift-2 does the rest of the work.
- */
-.tilt[data-lit='true'] .tilt__inner {
-  transition: transform 90ms linear;
-  transform:
-    rotateX(calc(var(--ty, 0) * -1 * var(--tilt-deg, 5deg)))
-    rotateY(calc(var(--tx, 0) * var(--tilt-deg, 5deg)))
-    translateY(-3px);
-}
-
-/*
- * Genuine Z depth, reserved for elements with no text in them. The icon tile is
- * a vector on a solid fill, so it resamples cleanly and reads as sitting
- * proud of the card face while the card turns.
- */
-.tilt__pop {
-  transform: translateZ(30px);
-}
-
-@media (hover: none) {
-  /* No pointer to track: hold everything flat rather than tilting on tap. */
-  .tilt__inner,
-  .tilt[data-lit='true'] .tilt__inner {
-    transform: none;
-  }
-}
-
-/* ====================================================================
-   10. QUICK NAV
-   ==================================================================== */
-
-.home-theme .quicknav {
-  padding-top: clamp(8px, 2vw, 24px);
-  padding-bottom: clamp(36px, 6vw, 76px);
-}
-
-.home-theme .quicknav__grid {
-  gap: 20px;
-}
-
-.home-theme .quicknav__card {
-  display: flex;
-  flex-direction: column;
-  gap: 22px;
-  padding: 28px 28px 30px;
-}
-
-/* Icon left, figure right, on one line above the reading column. */
-.home-theme .quicknav__head {
-  display: flex;
-  align-items: flex-start;
-  justify-content: space-between;
-  gap: 20px;
-}
-
-.home-theme .quicknav__text {
-  flex: 1;
-  display: flex;
-  flex-direction: column;
-  align-items: flex-start;
-  gap: 9px;
-}
-
-/*
- * The lead card is wide enough to run the whole thing on one line, which is
- * what makes it read as the primary card rather than just a longer one.
- */
-@media (min-width: 880px) {
-  .home-theme .quicknav__card--wide {
-    flex-direction: row;
-    align-items: center;
-    gap: 30px;
-    padding: 34px 36px;
-  }
-
-  /*
-   * `display: contents` dissolves the header wrapper so the icon and the
-   * figure become direct children of the card's flex row. That lets the three
-   * pieces be re-ordered into icon → copy → figure without duplicating the
-   * markup for the two layouts.
-   */
-  .home-theme .quicknav__card--wide .quicknav__head {
-    display: contents;
-  }
-
-  .home-theme .quicknav__card--wide .tile {
-    order: 0;
-  }
-
