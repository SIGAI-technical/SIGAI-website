+/**
+ * Small DOM helpers shared by the behaviour modules.
+ *
+ * `$` and `$$` are deliberately typed loosely. Everything under `src/lib` that
+ * imports them is direct DOM code ported from the single-file build, where the
+ * markup and the script were written together and every selector is known to
+ * match. Typing these as `Element | null` would force a null check on roughly
+ * two hundred call sites that cannot be null, and the checks would be noise
+ * rather than safety. The modules that use them all bail early when their own
+ * root element is missing, which is the check that actually matters.
+ */
+
+/* eslint-disable @typescript-eslint/no-explicit-any */
+
+export const $ = (sel: string, root?: ParentNode | Document): any =>
+  (root || document).querySelector(sel);
+
+export const $$ = (sel: string, root?: ParentNode | Document): any[] =>
+  Array.prototype.slice.call((root || document).querySelectorAll(sel));
+
+/** Visitors who asked for less motion. Every decorative effect checks this. */
+export const calm = (): boolean =>
+  typeof window !== 'undefined' &&
+  window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+/** Coarse pointer: no hover, so pointer-driven effects have nothing to track. */
+export const touch = (): boolean =>
+  typeof window !== 'undefined' && window.matchMedia('(hover: none)').matches;
+
+export function svgIcon(path: string, size: number): string {
+  return (
+    '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24"' +
+    ' fill="currentColor" aria-hidden="true"><path d="' + path + '"/></svg>'
+  );
+}
