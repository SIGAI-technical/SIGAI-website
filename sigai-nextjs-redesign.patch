+import PopUp from './PopUp';
+
+/**
+ * Every page except Home opens on this block, so the set reads as one site
+ * rather than five separately designed pages. The rule under the heading draws
+ * itself in as the heading rises up the screen.
+ */
+export default function Masthead({
+  eyebrow,
+  title,
+  lede,
+  id,
+}: {
+  eyebrow: string;
+  title: React.ReactNode;
+  lede: string;
+  id: string;
+}) {
+  return (
+    <header className="shell masthead">
+      <PopUp angle="12deg">
+        <span className="eyebrow">{eyebrow}</span>
+      </PopUp>
+      <PopUp delay={70} angle="16deg">
+        <h1 className="masthead__title" id={id}>
+          {title}
+        </h1>
+      </PopUp>
+      <PopUp delay={120} angle="12deg">
+        <p className="section-lede">{lede}</p>
+      </PopUp>
+      <PopUp delay={170} angle="10deg">
+        <div className="rule rule--draw" aria-hidden />
+      </PopUp>
+    </header>
+  );
+}
