@@ -0,0 +1,77 @@
+/**
+ * The floating 3D cubes behind the page.
+ *
+ * Real CSS 3D boxes — six faces each inside a preserve-3d context — not flat
+ * squares with a gradient painted to look like boxes. They rotate continuously,
+ * and a faked cube falls apart the moment it turns.
+ *
+ * Positions are hand-placed at the extreme viewport edges rather than
+ * randomised: a random scatter produces clumps and dead zones, and would drop
+ * shapes straight onto the hero copy.
+ */
+
+import { $, calm, touch } from './dom';
+
+const SHAPES = [
+  { x: -2,  y: 10, s: 46, d: 0.85, tone: 'blue',  spin: 24, rx: -18, ry: 32 },
+  { x: 100, y: 6,  s: 30, d: 0.55, tone: 'amber', spin: 38, rx: 24,  ry: -14 },
+  { x: 97,  y: 30, s: 58, d: 1,    tone: 'blue',  spin: 30, rx: -26, ry: 18 },
+  { x: -1,  y: 40, s: 26, d: 0.4,  tone: 'teal',  spin: 44, rx: 12,  ry: -28 },
+  { x: 101, y: 58, s: 38, d: 0.72, tone: 'amber', spin: 27, rx: -20, ry: 26 },
+  { x: -3,  y: 68, s: 52, d: 0.92, tone: 'teal',  spin: 33, rx: 22,  ry: -20 },
+  { x: 99,  y: 86, s: 32, d: 0.5,  tone: 'blue',  spin: 41, rx: -14, ry: 30 },
+  { x: 0,   y: 92, s: 40, d: 0.66, tone: 'amber', spin: 29, rx: 18,  ry: -24 }
+];
+
+export function initShapes(): void {
+  const host = $('#shapes');
+  if (!host) return;
+
+  const faces = ['fx', 'fy', 'fz', 'fxb', 'fyb', 'fzb'];
+  let html = '';
+  for (let i = 0; i < SHAPES.length; i++) {
+    const s = SHAPES[i];
+    const style =
+      'left:' + s.x + '%;top:' + s.y + '%;' +
+      '--s:' + s.s + 'px;--d:' + s.d + ';--spin:' + s.spin + 's;' +
+      '--rx:' + s.rx + 'deg;--ry:' + s.ry + 'deg;' +
+      /* Desynchronise the tumble so they never pulse in unison. */
+      '--offset:-' + (i * 1.7) + 's';
+    let box = '';
+    for (let f = 0; f < faces.length; f++) {
+      box += '<span class="shape__face shape__face--' + faces[f] + '"></span>';
+    }
+    html += '<div class="shape shape--' + s.tone + '" style="' + style + '">' +
+            '<div class="shape__box">' + box + '</div></div>';
+  }
+  host.innerHTML = html;
+
+  if (calm() || touch() || window.matchMedia('(max-width: 1180px)').matches) return;
+
+  /* Everything is driven from custom properties on this one node. Eight
+     elements each being restyled per event would be eight style
+     recalculations a frame; one write that eight elements read is one. */
+  let px = 0, py = 0, sy = 0, frame = 0;
+
+  function paint() {
+    frame = 0;
+    host.style.setProperty('--px', px.toFixed(3));
+    host.style.setProperty('--py', py.toFixed(3));
+    host.style.setProperty('--sy', sy.toFixed(1));
+  }
+  function schedule() { if (!frame) frame = requestAnimationFrame(paint); }
+
+  window.addEventListener('pointermove', function (e: PointerEvent) {
+    px = (e.clientX / window.innerWidth) * 2 - 1;
+    py = (e.clientY / window.innerHeight) * 2 - 1;
+    schedule();
+  }, { passive: true });
+
+  window.addEventListener('scroll', function () {
+    sy = window.scrollY;
+    schedule();
+  }, { passive: true });
+
+  sy = window.scrollY;
+  paint();
+}
diff --git a/src/lib/chrome.ts b/src/lib/chrome.ts
new file mode 100644
index 0000000..936b823
--- /dev/null
+++ b/src/lib/chrome.ts
@@ -0,0 +1,173 @@
+/**
+ * Site furniture: the header's nav indicator and mobile sheet, the opening
+ * curtain, and the light/dark switch.
+ */
+
+import { $, $$, calm } from './dom';
+
+/* ==========================================================================
+   Header
+   ========================================================================== */
+
+export function initHeader(): () => void {
+  const rail = $('#navRail');
+
+  /* The indicator follows the route, not the scroll position: the nav names
+     pages, not sections. It is returned so the layout can re-run it when Next
+     changes route without a reload. */
+  const moveNavIndicator = function () {
+    if (!rail) return;
+    const active = $('.nav-link[data-active="true"]', rail);
+    if (!active) { rail.style.setProperty('--o', '0'); return; }
+    rail.style.setProperty('--x', active.offsetLeft + 'px');
+    rail.style.setProperty('--w', active.offsetWidth + 'px');
+    rail.style.setProperty('--o', '1');
+  };
+
+  window.addEventListener('resize', moveNavIndicator);
+  // Link widths shift once the display font settles; measure again then.
+  if (document.fonts && document.fonts.ready) {
+    document.fonts.ready.then(moveNavIndicator).catch(function () {});
+  }
+
+  /* --- Mobile sheet --------------------------------------------------- */
+  const burger = $('#burger');
+  const sheet = $('#sheet');
+  if (!burger || !sheet) { moveNavIndicator(); return moveNavIndicator; }
+
+  function setOpen(open: boolean) {
+    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
+    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
+    sheet.hidden = !open;
+    /* A full-screen sheet must not scroll the page behind it. */
+    document.body.style.overflow = open ? 'hidden' : '';
+  }
+
+  burger.addEventListener('click', function () {
+    setOpen(burger.getAttribute('aria-expanded') !== 'true');
+  });
+
+  $$('a', sheet).forEach(function (a) {
+    a.addEventListener('click', function () { setOpen(false); });
+  });
+
+  window.addEventListener('keydown', function (e: KeyboardEvent) {
+    if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setOpen(false);
+  });
+
+  /* Close the sheet once the viewport is wide enough for the full bar. */
+  const mq = window.matchMedia('(min-width: 901px)');
+  mq.addEventListener('change', function () { if (mq.matches) setOpen(false); });
+
+  moveNavIndicator();
+  return moveNavIndicator;
+}
+
+/* ==========================================================================
+   Opening curtain
+   ==========================================================================
+   The nine tiles each show one ninth of the mark; together they rebuild it as
+   they land. A first load only, and never with reduced motion — the bootstrap
+   script in the document head decides before first paint. */
+
+export function initIntro(logo: string): void {
+  const intro = $('#intro');
+  const board = $('#introBoard');
+  if (!intro || !board) return;
+
+  if (document.documentElement.getAttribute('data-intro') !== '1') {
+    intro.remove();
+    return;
+  }
+
+  let html = '';
+  for (let r = 0; r < 3; r++) {
+    for (let c = 0; c < 3; c++) {
+      const pos = (c * 50) + '% ' + (r * 50) + '%';
+      const delay = (r * 3 + c) * 70;
+      html += '<span class="intro__tile" style="background-image:url(' + logo + ');' +
+              'background-position:' + pos + ';animation-delay:' + delay + 'ms"></span>';
+    }
+  }
+  board.innerHTML = html;
+
+  window.setTimeout(function () {
+    intro.setAttribute('data-exit', '1');
+    window.setTimeout(function () {
+      intro.remove();
+      document.documentElement.removeAttribute('data-intro');
+    }, 800);
+  }, 2200);
+}
+
+/* ==========================================================================
+   Theme
+   ==========================================================================
+
+   Three states, not two. An explicit choice stamps `data-theme` on <html>; the
+   default "follow the system" state stamps nothing at all, and the stylesheet's
+   prefers-color-scheme block decides. That is why reflectTheme() never stamps:
+   describing the current theme must not quietly turn "following the OS" into a
+   choice the visitor never made.
+
+   The switch runs through a View Transition — the old page is snapshotted,
+   stacked, and the incoming one is clipped open from the button, so the new
+   theme floods across the page from the point you pressed. Browsers without the
+   API get the same instant swap they would have had anyway. */
+
+export function currentTheme(): 'dark' | 'light' {
+  const stamped = document.documentElement.getAttribute('data-theme');
+  if (stamped === 'dark' || stamped === 'light') return stamped;
+  return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+}
+
+function reflectTheme(t: string): void {
+  const btn = $('#themeToggle');
+  if (btn) {
+    btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
+  }
+  const meta = document.querySelector('meta[name="theme-color"]');
+  if (meta) meta.setAttribute('content', t === 'dark' ? '#000000' : '#f7f4ee');
+}
+
+function applyTheme(next: string): void {
+  document.documentElement.setAttribute('data-theme', next);
+  try { localStorage.setItem('sigai-theme', next); } catch { /* private mode */ }
+  reflectTheme(next);
+}
+
+export function initTheme(): void {
+  const btn = $('#themeToggle');
+  if (!btn) return;
+  reflectTheme(currentTheme());
+
+  /* Someone changing their OS theme while the page is open, and who has never
+     pressed the button, should follow along. */
+  const mq = window.matchMedia('(prefers-color-scheme: dark)');
+  mq.addEventListener('change', function () {
+    if (!document.documentElement.getAttribute('data-theme')) reflectTheme(currentTheme());
+  });
+
+  btn.addEventListener('click', function () {
+    const next = currentTheme() === 'dark' ? 'light' : 'dark';
+
+    if (calm() || !document.startViewTransition) { applyTheme(next); return; }
+
+    const r = btn.getBoundingClientRect();
+    const x = r.left + r.width / 2;
+    const y = r.top + r.height / 2;
+    // Radius out to the furthest corner, so the wipe clears the whole page.
+    const end = Math.hypot(Math.max(x, window.innerWidth - x),
+                         Math.max(y, window.innerHeight - y));
+
+    const vt = document.startViewTransition(function () { applyTheme(next); });
+    vt.ready.then(function () {
+      document.documentElement.animate(
+        { clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)',
+                     'circle(' + end + 'px at ' + x + 'px ' + y + 'px)'] },
+        { duration: 620, easing: 'cubic-bezier(.16,1,.3,1)',
+          pseudoElement: '::view-transition-new(root)' }
+      );
+    }).catch(function () { /* transition cancelled — the theme still applied */ });
+  });
+}
