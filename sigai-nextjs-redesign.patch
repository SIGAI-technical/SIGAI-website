+import { CONTACT_ROWS, ICON } from '@/lib/content';
+
+export default function ContactCards() {
+  return (
+    <ul className="contact-grid" id="contactGrid">
+      {CONTACT_ROWS.map((r, i) => {
+        const card = (
+          <Tilt deg={6} spotlight>
+            <span className="contact-card">
+              <span className={`tile tile--${r.tone} tilt__pop`} aria-hidden>
+                <Icon path={ICON[r.icon]} size={20} />
+              </span>
+              <span className="contact-card__label">{r.label}</span>
+              <span
+                className="contact-card__value"
+                style={r.wrap ? undefined : { whiteSpace: 'nowrap' }}
+              >
+                {r.value}
+              </span>
+            </span>
+          </Tilt>
+        );
+
+        return (
+          <li
+            key={r.label}
+            className="popup"
+            style={
+              {
+                '--popup-delay': `${i * 80}ms`,
+                '--popup-angle': '18deg',
+              } as React.CSSProperties
+            }
+          >
+            {r.href ? (
+              <a href={r.href} className="contact-link">
+                {card}
+              </a>
+            ) : (
+              <div className="contact-link">{card}</div>
+            )}
+          </li>
+        );
+      })}
+    </ul>
+  );
+}
