+/**
+ * The page's motion primitives: pop-up reveals, pointer tilt, magnetic
+ * controls, count-up figures, and the one scroll handler everything
+ * scroll-linked reads from.
+ *
+ * The pattern throughout is the same — the maths lives here and writes a custom
+ * property; the stylesheet decides what the number means. That keeps the
+ * rotation, the lift and the reduced-motion opt-out in one place rather than
+ * split across two languages.
+ */
+
+import { $, $$, calm, touch } from './dom';
+
+/* ==========================================================================
+   Pop-up reveal
+   ========================================================================== */
+
+/**
+ * Failsafe: nothing that carries content may stay folded away.
+ *
+ * The reveal depends on IntersectionObserver firing, and there are contexts
+ * where it does not — a host that sizes an embedding iframe after load, a
+ * thumbnail or print capture that never scrolls, an observer starved during
+ * a long main-thread task. In every one of those the page would render with
+ * its content at opacity 0, which is indistinguishable from a broken page.
+ * So a short timer opens anything still folded, and `load` does the same.
+ * The animation is the enhancement; the content being visible is not.
+ */
+function openStragglers(): void {
+  $$('.popup').forEach(function (el) { el.classList.add('is-open'); });
+}
+
+function armPopUpFailsafe(): void {
+  window.setTimeout(openStragglers, 1800);
+  window.addEventListener('load', function () {
+    window.setTimeout(openStragglers, 1200);
+  });
+}
+
+export function initPopUps(): void {
+  const items = $$('.popup');
+
+  if (calm() || typeof IntersectionObserver === 'undefined') {
+    items.forEach(function (el) { el.classList.add('is-open'); });
+    return;
+  }
+
+  armPopUpFailsafe();
+
+  const io = new IntersectionObserver(function (entries) {
+    entries.forEach(function (entry) {
+      if (!entry.isIntersecting) return;
+      entry.target.classList.add('is-open');
+      io.unobserve(entry.target);
+    });
+  }, { rootMargin: '0px 0px -6% 0px', threshold: 0 });
+
+  items.forEach(function (el) { io.observe(el); });
+}
