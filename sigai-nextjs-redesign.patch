@@ -0,0 +1,133 @@
+'use client';
+
+import { useEffect, useMemo, useRef, useState } from 'react';
+import Icon from './Icon';
+import PopUp from './PopUp';
+import Placeholder from './Placeholder';
+import Tabs, { type TabItem } from './Tabs';
+import Tilt from './Tilt';
+import { initTiltIn, observePopUpsIn } from '@/lib/motion';
+import { CORES, SOCIALS, type Member } from '@/lib/content';
+
+const LINKEDIN = SOCIALS[0].path;
+const INSTAGRAM = SOCIALS[1].path;
+
+/**
+ * One person. The portrait slot is deliberately empty, and a member with no
+ * social handle on file simply gets no icons — a dead link is worse than none.
+ */
+function MemberCard({ m, i }: { m: Member; i: number }) {
+  const links = [
+    m.linkedin && { href: m.linkedin, path: LINKEDIN, label: 'LinkedIn' },
+    m.instagram && { href: m.instagram, path: INSTAGRAM, label: 'Instagram' },
+  ].filter(Boolean) as { href: string; path: string; label: string }[];
+
+  return (
+    <li
+      className="popup"
+      style={
+        {
+          '--popup-delay': `${Math.min(i, 8) * 45}ms`,
+          '--popup-angle': '16deg',
+        } as React.CSSProperties
+      }
+    >
+      <Tilt deg={5}>
+        <article className="member">
+          <div className="member__media">
+            <Placeholder label="Photo to be added" variant="avatar" />
+          </div>
+          <div className="member__body">
+            <span className="member__name">{m.name}</span>
+            <span className="member__role">{m.role}</span>
+            <span className="member__spacer" />
+            {links.length > 0 && (
+              <div className="member__links">
+                {links.map((l) => (
+                  <a
+                    key={l.label}
+                    className="member__link"
+                    href={l.href}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    aria-label={`${m.name} on ${l.label}`}
+                  >
+                    <Icon path={l.path} size={14} />
+                  </a>
+                ))}
+              </div>
+            )}
+          </div>
+        </article>
+      </Tilt>
+    </li>
+  );
+}
+
+/** One tab per published year: faculty coordinators first, then the core. */
+export default function TeamBrowser() {
+  const [year, setYear] = useState(CORES[0].year);
+  const panel = useRef<HTMLDivElement>(null);
+
+  const items: TabItem[] = useMemo(
+    () =>
+      CORES.map((c) => ({
+        value: c.year,
+        label: c.year,
+        count: c.faculty.length + c.committee.length,
+      })),
+    [],
+  );
+
+  const core = CORES.find((c) => c.year === year) ?? CORES[0];
+
+  useEffect(() => {
+    if (!panel.current) return;
+    observePopUpsIn(panel.current);
+    initTiltIn(panel.current);
+  }, [year]);
+
+  return (
+    <>
+      <PopUp delay={60}>
+        <Tabs
+          items={items}
+          value={year}
+          onChange={setYear}
+          label="Choose an academic year"
+          id="teamTabs"
+        />
+      </PopUp>
+
+      <p className="tabs-count" aria-live="polite">
+        {core.faculty.length} faculty · {core.committee.length} student core · {year}
+      </p>
+
+      <div id="teamPanel" ref={panel}>
+        <div className="team__group">
+          <div className="team__grouphead">
+            <span className="team__grouptitle">Faculty coordinators</span>
+            <span className="team__rule" />
+          </div>
+          <ul className="team__grid team__grid--faculty">
+            {core.faculty.map((m, i) => (
+              <MemberCard key={m.name} m={m} i={i} />
+            ))}
+          </ul>
+        </div>
+
+        <div className="team__group">
+          <div className="team__grouphead">
+            <span className="team__grouptitle">Student core</span>
+            <span className="team__rule" />
+          </div>
+          <ul className="team__grid">
+            {core.committee.map((m, i) => (
+              <MemberCard key={m.name} m={m} i={i} />
+            ))}
+          </ul>
+        </div>
+      </div>
+    </>
+  );
+}
