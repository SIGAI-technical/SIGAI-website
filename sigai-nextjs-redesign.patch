--- /dev/null
+++ b/src/components/Icon.tsx
@@ -0,0 +1,27 @@
+/**
+ * One 24-grid glyph. Every icon on the site is a single path drawn inline —
+ * an icon font or an SVG sprite would be a network request for something that
+ * costs a couple of hundred bytes in the markup.
+ */
+export default function Icon({
+  path,
+  size = 16,
+  className,
+}: {
+  path: string;
+  size?: number;
+  className?: string;
+}) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill="currentColor"
+      aria-hidden
+      className={className}
+    >
+      <path d={path} />
+    </svg>
+  );
+}
