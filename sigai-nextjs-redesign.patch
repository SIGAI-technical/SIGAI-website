+    el.addEventListener('pointermove', function (e: PointerEvent) {
+      if (frame) return;
+      const cx = e.clientX, cy = e.clientY;
+      frame = requestAnimationFrame(function () {
+        frame = 0;
+        const r = el.getBoundingClientRect();
+        if (!r.width || !r.height) return;
+        const x = cx - r.left, y = cy - r.top;
+        el.style.setProperty('--tx', ((x / r.width) * 2 - 1).toFixed(3));
+        el.style.setProperty('--ty', ((y / r.height) * 2 - 1).toFixed(3));
+        if (spot) {
+          el.style.setProperty('--mx', x + 'px');
+          el.style.setProperty('--my', y + 'px');
+        }
+      });
+    });
+
+    /* data-lit gates will-change in CSS, so a grid of cards does not hold a
+       compositor layer each while the pointer is elsewhere. */
+    el.addEventListener('pointerenter', function () {
+      el.setAttribute('data-lit', 'true');
+    });
+
+    el.addEventListener('pointerleave', function () {
+      if (frame) { cancelAnimationFrame(frame); frame = 0; }
+      el.removeAttribute('data-lit');
+      el.style.setProperty('--tx', '0');
+      el.style.setProperty('--ty', '0');
+    });
+  });
+}
+
+/* ==========================================================================
+   Magnetic controls
+   ========================================================================== */
+
+export function initMagnetic(): void {
+  if (calm() || touch()) return;
+
+  const STRENGTH = 9;
+  const RADIUS = 70;
+  const items = $$('.magnetic');
+  if (!items.length) return;
+  let frame = 0;
+
+  window.addEventListener('pointermove', function (e: PointerEvent) {
+    if (frame) return;
+    const cx = e.clientX, cy = e.clientY;
+    frame = requestAnimationFrame(function () {
+      frame = 0;
+      items.forEach(function (el) {
+        const r = el.getBoundingClientRect();
+        if (!r.width) return;
+        const dx = cx - (r.left + r.width / 2);
+        const dy = cy - (r.top + r.height / 2);
+
+        /* Distance to the nearest point of the box, not to its centre — a
+           wide button should not need the cursor near its middle. */
+        const gapX = Math.max(0, Math.abs(dx) - r.width / 2);
+        const gapY = Math.max(0, Math.abs(dy) - r.height / 2);
+        const gap = Math.sqrt(gapX * gapX + gapY * gapY);
+
+        if (gap > RADIUS) {
+          el.style.setProperty('--mag-x', '0px');
+          el.style.setProperty('--mag-y', '0px');
+          el.removeAttribute('data-pulled');
+          return;
+        }
+
+        /* Full pull at the edge of the box, easing to nothing at the rim. */
+        const falloff = 1 - gap / RADIUS;
+        const nx = Math.max(-1, Math.min(1, dx / (r.width / 2 + RADIUS)));
+        const ny = Math.max(-1, Math.min(1, dy / (r.height / 2 + RADIUS)));
+        el.style.setProperty('--mag-x', (nx * STRENGTH * falloff).toFixed(2) + 'px');
+        el.style.setProperty('--mag-y', (ny * STRENGTH * falloff).toFixed(2) + 'px');
+        el.setAttribute('data-pulled', 'true');
+      });
+    });
+  }, { passive: true });
+}
+
+/* ==========================================================================
+   Count-up figures
+   ========================================================================== */
+
+export function initCountUp(): void {
+  const items = $$('[data-count]');
+  if (calm() || typeof IntersectionObserver === 'undefined' || !items.length) return;
+
+  const io = new IntersectionObserver(function (entries) {
+    entries.forEach(function (entry) {
+      if (!entry.isIntersecting) return;
+      const el = entry.target as HTMLElement;
+      io.unobserve(el);
+
+      const target = parseInt(el.getAttribute('data-count') || '', 10);
+      if (isNaN(target)) return;
+      const t0 = performance.now();
+      const DURATION = 1100;
+
+      el.style.fontVariantNumeric = 'tabular-nums';
+      el.textContent = '0';
+
+      (function tick(now: number) {
+        const p = Math.min(1, (now - t0) / DURATION);
+        /* Ease-out cubic: fast off the mark, settling gently onto the
+           number — a counter arriving, not a value scrubbing. */
+        const eased = 1 - Math.pow(1 - p, 3);
+        el.textContent = String(Math.round(eased * target));
+        if (p < 1) requestAnimationFrame(tick);
+      })(performance.now());
+    });
+  }, { threshold: 0.5 });
+
+  items.forEach(function (el) { io.observe(el); });
+}
+
+/* ==========================================================================
+   Scroll effects
+   ==========================================================================
+
+   One scroll handler writes one progress value per frame; the stylesheet
+   spends it. Keeping the maths here and the motion in CSS means the hero
+   parallax, the heading rules and the reduced-motion opt-out all live in one
+   place instead of being half in JavaScript. */
+
+export function initScrollFx(): void {
+  const header = $('#header');
+  const progress = $('#progress');
+  let frame = 0;
+
+  function paint() {
+    frame = 0;
+    const y = window.scrollY;
+    const vh = window.innerHeight;
+
+    header.setAttribute('data-scrolled', y > 8 ? 'true' : 'false');
+
+    const max = document.documentElement.scrollHeight - vh;
+    progress.style.setProperty('--p', max > 0 ? Math.min(1, y / max).toFixed(4) : '0');
+
+    if (calm()) return;
+
+    /* Hero parallax: 0 at rest, 1 once the hero has travelled a screen. The
+       copy rises, the cube sinks and shrinks slightly, so the hero has depth
+       on the way out instead of sliding off as one flat sheet. */
+    const hero = $('.page .hero');
+    if (hero) {
+      hero.style.setProperty('--hero-p', Math.min(1, Math.max(0, y / (vh * 0.9))).toFixed(4));
+    }
+
+    /* Heading rules draw themselves in as the heading rises up the screen.
+       Measured from the bottom edge, so a rule that is already on the first
+       screen reads as finished rather than as a stub someone forgot to
+       complete — the effect belongs to rules you scroll down to. */
+    $$('.page .rule--draw').forEach(function (el) {
+      const top = el.getBoundingClientRect().top;
+      const p = (vh - top) / (vh * 0.35);
+      el.style.setProperty('--draw', Math.min(1, Math.max(0, p)).toFixed(3));
+    });
+  }
+
+  const syncScroll = function () { if (!frame) frame = requestAnimationFrame(paint); };
+
+  window.addEventListener('scroll', syncScroll, { passive: true });
+  window.addEventListener('resize', syncScroll, { passive: true });
+  paint();
+}
