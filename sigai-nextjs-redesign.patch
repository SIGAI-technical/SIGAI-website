+import Link from 'next/link';
+import Icon from './Icon';
+import PopUp from './PopUp';
+import { ICON } from '@/lib/content';
+
+/**
+ * Where to go next, set as an index.
+ *
+ * This was three rounded cards in a grid, each with an app-icon tile, a corner
+ * gradient and a drop shadow — the layout every site builder emits by default,
+ * and the reason the page read as machine-assembled. It is the same three
+ * destinations now: a number in the margin, a rule between entries, the figure
+ * held out to the right, and no container at all. The interaction is still
+ * physical — the entry steps in, the accent rule draws itself across, the arrow
+ * travels — it just has nothing to float.
+ */
+const ROWS = [
+  {
+    no: '01',
+    href: '/events',
+    tone: 'gold',
+    title: 'Everything we have run',
+    desc: 'Clockout, Genesis and Synergy — eight events across three academic years, from orientation seminars through to a campus-wide hunt.',
+    cta: 'Browse the archive',
+    count: 8,
+    unit: 'Events',
+  },
+  {
+    no: '02',
+    href: '/team',
+    tone: 'blue',
+    title: 'The people behind it',
+    desc: 'Faculty coordinators and the student core, published year by year since 2023.',
+    cta: 'Meet the team',
+    count: 22,
+    unit: 'On the core',
+  },
+  {
+    no: '03',
+    href: '/domains',
+    tone: 'teal',
+    title: 'What we actually explore',
+    desc: 'Artificial intelligence, machine learning and deep learning — and the mechanics sitting underneath them.',
+    cta: 'See the fields',
+    count: 6,
+    unit: 'Fields',
+  },
+];
+
+export default function IndexNav() {
+  return (
+    <section className="quicknav" aria-label="Explore SIGAI">
+      <div className="shell">
+        <PopUp className="index__head">
+          <span className="eyebrow">Index</span>
+          <p className="index__note">Three places to go from here.</p>
+        </PopUp>
+
+        <nav className="index" aria-label="Sections">
+          {ROWS.map((r, i) => (
+            <Link
+              key={r.href}
+              className="index__row popup"
+              href={r.href}
+              data-tone={r.tone}
+              style={
+                {
+                  '--popup-delay': `${i * 80}ms`,
+                  '--popup-angle': '14deg',
+                } as React.CSSProperties
+              }
+            >
+              <span className="index__no" aria-hidden>
+                {r.no}
+              </span>
+              <span className="index__main">
+                <span className="index__title">{r.title}</span>
+                <span className="index__desc">{r.desc}</span>
+                <span className="index__cta">
+                  {r.cta} <Icon path={ICON.arrow} size={15} />
+                </span>
+              </span>
+              <span className="index__fig" aria-hidden>
+                <b data-count={r.count}>{r.count}</b>
+                <span>{r.unit}</span>
+              </span>
+            </Link>
+          ))}
+        </nav>
+      </div>
+    </section>
+  );
+}
