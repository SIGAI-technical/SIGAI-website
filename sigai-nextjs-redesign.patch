+'use client';
+
+import { useEffect, useMemo, useRef, useState } from 'react';
+import PopUp from './PopUp';
+import Placeholder from './Placeholder';
+import Tabs, { type TabItem } from './Tabs';
+import Tilt from './Tilt';
+import { initTiltIn } from '@/lib/motion';
+import { observePopUpsIn } from '@/lib/motion';
+import { EVENTS, EVENT_YEARS } from '@/lib/content';
+
+/**
+ * A filterable archive. Every card leads with an empty 16:10 photo slot —
+ * labelled, so it reads as a slot waiting for a photograph rather than as an
+ * image that failed to load. Dropping the pictures in later means replacing one
+ * element per card and nothing else.
+ */
+export default function EventsBrowser() {
+  const [year, setYear] = useState('all');
+  const grid = useRef<HTMLUListElement>(null);
+
+  const items: TabItem[] = useMemo(
+    () => [
+      { value: 'all', label: 'All years', count: EVENTS.length },
+      ...EVENT_YEARS.map((y) => ({
+        value: y,
+        label: y,
+        count: EVENTS.filter((e) => e.year === y).length,
+      })),
+    ],
+    [],
+  );
+
+  const list = year === 'all' ? EVENTS : EVENTS.filter((e) => e.year === year);
+
+  // These cards did not exist when the page-wide passes ran, and they are
+  // replaced wholesale on every tab change, so both behaviours re-arm here.
+  useEffect(() => {
+    if (!grid.current) return;
+    observePopUpsIn(grid.current);
+    initTiltIn(grid.current);
+  }, [year]);
+
+  return (
+    <>
+      <PopUp delay={60}>
+        <Tabs
+          items={items}
+          value={year}
+          onChange={setYear}
+          label="Filter events by academic year"
+          id="eventTabs"
+        />
+      </PopUp>
+
+      <p className="tabs-count" aria-live="polite">
+        {list.length} {list.length === 1 ? 'event' : 'events'}{' '}
+        {year === 'all' ? `across ${EVENT_YEARS.length} academic years` : `in ${year}`}
+      </p>
+
+      <ul className="events__grid" id="eventGrid" ref={grid}>
+        {list.map((ev, i) => (
+          <li
+            key={ev.id}
+            className="popup"
+            style={
+              {
+                '--popup-delay': `${Math.min(i, 6) * 60}ms`,
+                '--popup-angle': '18deg',
+              } as React.CSSProperties
+            }
+          >
+            <Tilt deg={4}>
+              <article className="event-card">
+                <div className="event-card__media">
+                  <Placeholder label={`${ev.title} — photo to be added`} variant="media" />
+                </div>
+                <div className="event-card__body">
+                  <div className="event-card__meta">
+                    <span className="event-card__series">{ev.series}</span>
+                    <span className="event-card__year">{ev.year}</span>
+                  </div>
+                  <h3 className="event-card__title">{ev.title}</h3>
+                  <p>{ev.description}</p>
+                </div>
+              </article>
+            </Tilt>
+          </li>
+        ))}
+      </ul>
+    </>
+  );
+}
