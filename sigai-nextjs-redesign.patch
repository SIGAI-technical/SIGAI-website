@@ -0,0 +1,40 @@
+'use client';
+
+import { useEffect } from 'react';
+import Icon from './Icon';
+import { initCube, initCubeStage } from '@/lib/cube';
+import { ICON } from '@/lib/content';
+import { LOGO_SRC } from '@/lib/site';
+
+/**
+ * The cube: 26 cubies of real CSS 3D, solving and re-scrambling on a loop,
+ * leaning toward the cursor, and grabbable.
+ *
+ * It is built imperatively rather than as JSX because it is 26 elements with
+ * 156 generated faces — React would gain nothing from owning that tree, and
+ * the solve loop mutates transforms every frame, which is exactly the work you
+ * do not want going through a renderer.
+ */
+export default function Cube() {
+  useEffect(() => {
+    const teardown = initCube(LOGO_SRC);
+    initCubeStage();
+    return teardown;
+  }, []);
+
+  return (
+    <div className="cube-pad">
+      <div className="cube-wrap" id="cubeWrap">
+        <div className="cube-lean" id="cubeLean">
+          <div className="cube-scale" id="cubeScale">
+            <div className="cube-frame" id="cubeFrame" />
+          </div>
+        </div>
+      </div>
+      <span className="cube-hint" aria-hidden>
+        <Icon path={ICON.grab} size={14} />
+        Drag to spin it
+      </span>
+    </div>
+  );
+}
